#!/usr/bin/env bash
# Pre-commit hook: run oxfmt and oxlint on staged .ts files.
# Installed via: git config core.hooksPath .githooks

set -euo pipefail

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|mts)$' || true)

if [ -z "$STAGED" ]; then
  exit 0
fi

echo "Running oxfmt --check on staged files..."
echo "$STAGED" | xargs npx oxfmt

echo "Running oxlint on staged files..."
echo "$STAGED" | xargs npx oxlint

echo "Pre-commit checks passed."
