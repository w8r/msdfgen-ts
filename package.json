{
  "name": "msdfgen-ts",
  "version": "0.1.0",
  "description": "Runtime MSDF font atlases for WebGL/WebGPU: a TypeScript port of msdfgen with a built-in TrueType parser. No WASM.",
  "keywords": [
    "atlas",
    "font",
    "msdf",
    "msdfgen",
    "sdf",
    "signed-distance-field",
    "text",
    "truetype",
    "webgl",
    "webgpu"
  ],
  "homepage": "https://github.com/w8r/msdfgen-ts#readme",
  "bugs": "https://github.com/w8r/msdfgen-ts/issues",
  "license": "MIT",
  "author": "Alexander Milevski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w8r/msdfgen-ts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/atlas-worker.js"
  ],
  "main": "./dist/msdfgen-ts.js",
  "module": "./dist/msdfgen-ts.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/msdfgen-ts.iife.js",
  "jsdelivr": "./dist/msdfgen-ts.iife.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/msdfgen-ts.js",
      "default": "./dist/msdfgen-ts.js"
    },
    "./worker": {
      "types": "./dist/types/atlas-worker.d.ts",
      "import": "./dist/atlas-worker.js",
      "default": "./dist/atlas-worker.js"
    }
  },
  "scripts": {
    "gate:m0": "vitest run test/diff.test.ts",
    "gate:m1": "vitest run test/parser/",
    "gate:m2a": "vitest run test/shape/normalize.test.ts",
    "gate:m2b": "vitest run test/msdf/sdf.test.ts",
    "gate:m2": "vitest run test/shape/normalize.test.ts test/msdf/sdf.test.ts",
    "gate:m3": "vitest run test/msdf/msdf.test.ts",
    "gate:m4": "vitest run test/atlas/",
    "gate:m5": "vitest run test/e2e.test.ts",
    "gate:m6": "vitest run test/size.test.ts && tsx --expose-gc tools/bench.ts",
    "gate:all": "vitest run test/diff.test.ts test/parser/ test/shape/normalize.test.ts test/msdf/ test/atlas/ test/e2e.test.ts",
    "bench:vitest": "vitest bench test/bench/",
    "gen-golden": "tsx tools/gen-golden.ts",
    "setup-reference": "bash tools/setup-reference.sh",
    "atlas-preview": "tsx tools/atlas-preview.ts",
    "screenshot": "tsx tools/screenshot.ts",
    "screenshot:setup": "playwright install chromium",
    "dev": "vite --open /demo/canvas/index.html",
    "dev:webgpu": "vite --open /demo/webgpu/index.html",
    "dev:webgl": "vite --open /demo/webgl/index.html",
    "dev:webgl-zoom": "vite --open /demo/webgl-zoom/index.html",
    "dev:webgpu-zoom": "vite --open /demo/webgpu-zoom/index.html",
    "dev:lucide": "vite --open /demo/lucide/index.html",
    "dev:bench": "vite --open /demo/bench/index.html",
    "build": "vite build && vite build --config vite.worker.config.ts && tsc -p tsconfig.build.json && tsx tools/fix-dts-extensions.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "predeploy": "npm run build:demo",
    "deploy": "gh-pages -d demo-dist --nojekyll",
    "size": "vite build && gzip -c dist/msdfgen-ts.iife.js | wc -c | awk '{printf \"%.1f KB (iife, gzip)\\n\", $1/1024}'",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "dev:hello-webgl": "vite --open /demo/hello-webgl/index.html",
    "dev:hello-webgpu": "vite --open /demo/hello-webgpu/index.html",
    "prepublishOnly": "npm run build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "potpack": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/opentype.js": "1.3.10",
    "@webgpu/types": "0.1.71",
    "gh-pages": "6.3.0",
    "opentype.js": "1.3.4",
    "oxfmt": "0.71.0",
    "oxlint": "1.0.0",
    "playwright": "1.62.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "6.3.0",
    "vitest": "3.2.0"
  }
}
